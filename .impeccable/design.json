      "css": ".ds-field{display:grid;gap:8px;color:var(--ink,#17211f);font:14px/1.5 system-ui, -apple-system, BlinkMacSystemFont, \"PingFang TC\", \"Microsoft JhengHei\", \"Noto Sans TC\", sans-serif}.ds-field input{font-family:system-ui, -apple-system, BlinkMacSystemFont, \"PingFang TC\", \"Microsoft JhengHei\", \"Noto Sans TC\", sans-serif;font-size:14px;line-height:1.4;min-width:0;min-height:40px;padding:8px 10px;border:1px solid #aab8b0;border-radius:8px;background:var(--card,#fff);color:var(--ink,#17211f)}.ds-field input::placeholder{color:var(--muted,#53645c)}.ds-field input:focus-visible{outline:2px solid var(--focus,#176b50);outline-offset:3px}"
